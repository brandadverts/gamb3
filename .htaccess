# Apache / cPanel: her adresin hazır HTML dosyası vardır (ör. /gamb3/en/products/index.html).
# Dosyası olmayan adresler 404 sayfasına düşer.
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /gamb3/404.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /gamb3/
  # Kök: /gamb3 → index.html
  RewriteRule ^$ index.html [L]
  # /gamb3/en/products → /gamb3/en/products/index.html (yönlendirme yapmadan)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>
